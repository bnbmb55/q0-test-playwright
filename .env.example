# Required for authenticated UI/API tests. Never commit real values.
Q0_EMAIL=
Q0_PASSWORD=

# Optional distinct test identities; they otherwise use Q0_EMAIL/Q0_PASSWORD.
Q0_DASHBOARD_EMAIL=
Q0_DASHBOARD_PASSWORD=
Q0_LOGIN_EMAIL=
Q0_LOGIN_PASSWORD=
Q0_TRAINING_EMAIL=
Q0_TRAINING_PASSWORD=

# Required only for the social-account rejection checks.
Q0_GOOGLE_EMAIL=
Q0_GOOGLE_PASSWORD=
Q0_GITHUB_EMAIL=
Q0_GITHUB_PASSWORD=

# Required only for RUN_BILLABLE_TRAINING=true.
Q0_AWS_SECRET_NAME=AWS Secret
Q0_AWS_ACCESS_KEY_ID=
Q0_AWS_SECRET_ACCESS_KEY=
